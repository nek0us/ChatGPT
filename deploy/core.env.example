# Shared ChatGPTWeb core configuration.
# Keep this file readable only by the service account: it contains credentials.
# Paths may be absolute or relative to the process working directory.

CHATGPTWEB_SESSIONS_FILE=/srv/chatgptweb/sessions/local_sessions.json
CHATGPTWEB_STORAGE_DIR=/srv/chatgptweb/storage
CHATGPTWEB_RUNTIME_LOG_PATH=/srv/chatgptweb/logs/core.log

# Bind only to loopback unless a reverse proxy and access controls are in place.
CHATGPTWEB_HTTP_HOST=127.0.0.1
CHATGPTWEB_HTTP_PORT=8000
CHATGPTWEB_CONTROL_HOST=127.0.0.1
CHATGPTWEB_CONTROL_PORT=8765

# Replace both values with long, distinct random strings. Do not commit them.
CHATGPTWEB_HTTP_API_KEY=replace-with-http-administrator-secret
CHATGPTWEB_CONTROL_API_KEY=replace-with-control-administrator-secret

CHATGPTWEB_HEADLESS=true
CHATGPTWEB_LOCAL_JS=false
CHATGPTWEB_LOG_LEVEL=INFO
